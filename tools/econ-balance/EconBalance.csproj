<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../Assets/_Game/Scripts/Sim/**/*.cs" />
    <!-- -p:CapMode=plus1 swaps in the roster cap proposed by ECON-01B (PR #20), without touching it. -->
    <Compile Remove="../../Assets/_Game/Scripts/Sim/Economy/CafeLevelTable.cs" Condition="'$(CapMode)'=='plus1'" />
    <Compile Include="alt/CafeLevelTable.plus1.cs" Condition="'$(CapMode)'=='plus1'" />
  </ItemGroup>
</Project>
